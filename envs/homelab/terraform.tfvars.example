# Copy to terraform.tfvars in a private overlay and fill in real values.
# Addresses below are from the documentation range (RFC 5737), not real hosts.

node_name      = "pve01"
template_vm_id = 2604001
datastore_id   = "local-zfs"

vms = {
  example01 = {
    cores        = 2
    memory_mb    = 4096
    vlan_id      = 7
    ipv4_address = "192.0.2.10/24"
    ipv4_gateway = "192.0.2.1"
    tags         = ["docker"]

    extra_disks = {
      data2 = { interface = "scsi2", size_gb = 100 }
    }
  }
}
